        "id": "e6310320"
      },
      "outputs": [],
      "source": [
        "from pathlib import Path\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 94,
      "id": "d3d99bfa",
      "metadata": {
        "id": "d3d99bfa"
      },
      "outputs": [],
      "source": [
        "sns.set_theme(style=\"whitegrid\", context=\"notebook\")\n",
        "plt.rcParams[\"figure.figsize\"] = (12, 4)\n",
        "plt.rcParams[\"axes.titlesize\"] = 11\n",
        "\n",
        "_here = Path.cwd()\n",
        "LAB_DIR = _here\n",
        "for p in (_here, _here / \"Lab_2\"):\n",
        "    if (p / \"Lab2_Коксование масла ГПА ст. №35 КС-18А.parquet\").exists() or (\n",
        "        p / \"Lab2_Коксование масла ГПА ст. №35 КС-18А.txt\"\n",
        "    ).exists():\n",
        "        LAB_DIR = p\n",
        "        break\n",
        "DATA_PARQUET = LAB_DIR / \"Lab2_Коксование масла ГПА ст. №35 КС-18А.parquet\"\n",
        "DATA_TXT = LAB_DIR / \"Lab2_Коксование масла ГПА ст. №35 КС-18А.txt\""
      ]
    },
    {
      "cell_type": "markdown",
      "id": "99a00a32",
      "metadata": {
        "id": "99a00a32"
      },
      "source": [
        "## Разведывательный анализ (EDA) и предобработка"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 95,
      "id": "8967a730",
      "metadata": {
        "id": "8967a730"
      },
      "outputs": [],
      "source": [
        "def load_lab2_table() -> pd.DataFrame:\n",
        "    if DATA_PARQUET.exists():\n",
        "        df = pd.read_parquet(DATA_PARQUET)\n",
        "    elif DATA_TXT.exists():\n",
        "        df = pd.read_csv(\n",
        "            DATA_TXT,\n",
        "            sep=\",\",\n",
        "            decimal=\",\",\n",
        "            low_memory=False,\n",
        "        )\n",
        "    df[\"TS\"] = pd.to_datetime(df[\"TS\"], errors=\"coerce\")\n",
        "    df = df.sort_values(\"TS\").reset_index(drop=True)\n",
        "    return df"
      ]
    },
