        "        inds = inds[0]\n",
        "        valid = [j for j in inds[1:] if abs(j - idx) > min_tsep]\n",
        "        if not valid:\n",
        "            continue\n",
        "        nn = valid[0]\n",
        "        for k in range(traj_len):\n",
        "            i1, i2 = idx + k, nn + k\n",
        "            if i1 >= len(X) or i2 >= len(X):\n",
