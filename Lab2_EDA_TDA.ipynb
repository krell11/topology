        "import nolds\n",
        "from nolds.measures import logarithmic_n\n",
        "import numpy as np\n",
        "\n",
        "%pip install nolds\n",
        "y_arr = y.values.astype(float)\n",
        "\n",
        "# R/S-анализ\n",
        "def calculate_hurst_rs(x, title=f\"R/S-анализ\"):\n",
        "    N = len(x)\n",
        "    max_window = N // 2\n",
        "    # размеры окон n в логарифмическом масштабе\n",
        "    n_vals = np.unique(np.logspace(np.log10(10), np.log10(max_window), 20).astype(int))\n",
        "\n",
        "    RS_vals = []\n",
        "\n",
        "    for n in n_vals:\n",
        "        truncated_x = x[:N - (N % n)]                # усекаем ряд, чтобы он делился на n без остатка\n",
        "        blocks = truncated_x.reshape(-1, n)          # и разбиваем на блоки\n",
        "\n",
        "        m = np.mean(blocks, axis=1, keepdims=True)   # среднее\n",
        "        Y = blocks - m                               # центрирование\n",
        "        Z = np.cumsum(Y, axis=1)                     # накопленное отклонение\n",
        "        R = np.max(Z, axis=1) - np.min(Z, axis=1)    # размах\n",
        "        S = np.std(blocks, axis=1, ddof=1)           # стандартное отклонение\n",
        "\n",
        "        # исключаем деление на ноль (если S == 0)\n",
        "        valid = S > 1e-8\n",
        "        RS_block = R[valid] / S[valid]\n",
        "\n",
        "        # усредняем R/S для текущего размера окна n\n",
        "        RS_vals.append(np.mean(RS_block))\n",
        "\n",
        "    # линейная регрессия в логарифмических координатах\n",
        "    log_n = np.log(n_vals)\n",
        "    log_RS = np.log(RS_vals)\n",
        "    H, C = np.polyfit(log_n, log_RS, 1)\n",
        "\n",
        "    fig, ax = plt.subplots(figsize=(7, 4))\n",
        "    ax.scatter(log_n, log_RS, s=30, label=\"R/S (блоки)\")\n",
        "    x_line = np.linspace(log_n.min(), log_n.max(), 100)\n",
        "    ax.plot(x_line, H * x_line + C, \"r--\", label=f\"МНК: H = {H:.3f}\")\n",
        "    ax.set_xlabel(\"ln(n)\")\n",
        "    ax.set_ylabel(\"ln(R/S)\")\n",
        "    ax.set_title(title)\n",
        "    ax.legend()\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "    return H\n"
      ]
    },
